# Cloud conversation and transcription (required for chat, file uploads, and cloud STT)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional premium Coqui voice. Without these, AILA uses the browser's voice.
HUGGINGFACE_TTS_ENDPOINT=
HUGGINGFACE_TOKEN=
COQUI_TTS_MODEL=coqui/XTTS-v2
COQUI_SPEAKER=Ana Florence
COQUI_LANGUAGE=en
